# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- NAVER API HUB (네이버클라우드 콘솔 > NAVER API HUB > Application > 인증 정보) ----
# 데이터랩 검색어트렌드·쇼핑인사이트 용. 국내 수요 추이.
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=
# 콘솔의 API 가이드에 적힌 주소가 다르면 여기서 바꾼다.
NAVER_HUB_BASE_URL=https://naveropenapi.apigw.ntruss.com
# ncp = X-NCP-APIGW-API-KEY-ID/KEY 헤더 (HUB 기본)
# openapi = X-Naver-Client-Id/Secret 헤더 (개발자센터 이관 유예 사용자)
NAVER_HUB_AUTH_STYLE=ncp

# ---- 네이버 검색광고 API (searchad.naver.com > 도구 > API 사용 관리) ----
# 키워드도구: 월간 검색수·클릭수·경쟁정도. 국내 경쟁 지표.
NAVER_AD_CUSTOMER_ID=
NAVER_AD_ACCESS_LICENSE=
NAVER_AD_SECRET_KEY=

# ---- 쿠팡 파트너스 API (partners.coupang.com > 링크 생성 > API) ----
# 상품 검색: 국내 판매가. 마진 계산용.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ---- 기타 ----
PROXY_URL=            # 선택, 해외 스크래핑용
USD_KRW_RATE=1380     # 나중에 API로 대체
